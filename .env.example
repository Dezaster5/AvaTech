# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-value
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=avtch.io,www.avtch.io,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://avtch.io,https://www.avtch.io
CORS_ALLOWED_ORIGINS=https://avtch.io,https://www.avtch.io,http://localhost:5173

# PostgreSQL. Leave empty for local SQLite when running backend without Docker.
# DATABASE_URL has priority over POSTGRES_* and is convenient for Neon/Render.
DATABASE_URL=
POSTGRES_DB=avtch
POSTGRES_USER=avtch
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Email
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=no-reply@avtch.io
EMAIL_HOST_PASSWORD=change-me
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=15
DEFAULT_FROM_EMAIL=AvaTech <no-reply@avtch.io>
CONTACT_RECEIVER_EMAIL=info@avtch.io
CONTACT_RECEIVER_EMAILS=info@avtch.io

# Contact form anti-spam
CONTACT_RATE_LIMIT_COUNT=5
CONTACT_RATE_LIMIT_WINDOW_SECONDS=900

# Frontend build
VITE_API_URL=/api
