DJANGO_SECRET_KEY=dev-only-change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,avtch.io,www.avtch.io
CSRF_TRUSTED_ORIGINS=http://localhost:5173,https://avtch.io,https://www.avtch.io
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://avtch.io,https://www.avtch.io

# Для локальной разработки можно оставить PostgreSQL-переменные пустыми, тогда будет SQLite.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=5432

# Если EMAIL_HOST не указан и DJANGO_DEBUG=True, Django использует console email backend.
EMAIL_BACKEND=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=AvaTech <no-reply@avtch.io>
CONTACT_RECEIVER_EMAIL=info@avtch.io

CONTACT_RATE_LIMIT_COUNT=5
CONTACT_RATE_LIMIT_WINDOW_SECONDS=900
